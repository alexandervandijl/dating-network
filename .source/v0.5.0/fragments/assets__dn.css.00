:root{--dn-border:#e7e2e4;--dn-muted:#6f6669;--dn-bg:#fffafb;--dn-accent:#8c3452;--dn-accent-dark:#6f2740;--dn-danger:#a72828;--dn-radius:16px}
.dn-wrap{max-width:1100px;margin:32px auto;padding:0 18px;box-sizing:border-box}.dn-narrow{max-width:720px}.dn-wrap *{box-sizing:border-box}.dn-wrap h1,.dn-wrap h2,.dn-wrap h3{line-height:1.2}.dn-lead{font-size:1.08rem;color:var(--dn-muted);margin-top:-6px}.dn-muted{color:var(--dn-muted)}
.dn-form,.dn-section,.dn-danger-zone,.dn-empty,.dn-principle,.dn-safety-actions{background:#fff;border:1px solid var(--dn-border);border-radius:var(--dn-radius);padding:22px;margin:18px 0;box-shadow:0 4px 20px rgba(70,35,50,.04)}.dn-section{box-shadow:none}.dn-section h2{margin-top:0}.dn-grid{display:grid;gap:16px}.dn-grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}.dn-grid-3{grid-template-columns:repeat(3,minmax(0,1fr))}@media(max-width:760px){.dn-grid-2,.dn-grid-3{grid-template-columns:1fr}}
.dn-form label,.dn-report-form label,.dn-danger-zone label{display:block;font-weight:650;margin:12px 0}.dn-form input,.dn-form select,.dn-form textarea,.dn-message-form textarea,.dn-report-form input,.dn-report-form select,.dn-report-form textarea,.dn-danger-zone input{width:100%;padding:12px 13px;border:1px solid #cfc6c9;border-radius:10px;background:#fff;font:inherit;margin-top:6px}.dn-form small,.dn-danger-zone small{display:block;color:var(--dn-muted);font-weight:400;margin-top:5px;line-height:1.4}.dn-check{display:flex!important;gap:10px;align-items:flex-start;font-weight:400!important}.dn-check input{width:auto!important;margin-top:4px!important}.dn-check span{line-height:1.5}
.dn-button{display:inline-block;border:0;border-radius:999px;padding:11px 18px;background:var(--dn-accent);color:#fff!important;text-decoration:none!important;font-weight:700;cursor:pointer;line-height:1.2}.dn-button:hover{background:var(--dn-accent-dark)}.dn-button-secondary{background:#f3ebee;color:var(--dn-accent-dark)!important}.dn-button-secondary:hover{background:#eadde2}.dn-button-danger{background:var(--dn-danger)}
.dn-notice{border-radius:12px;padding:13px 15px;margin:14px 0;border:1px solid}.dn-success{background:#eef9f1;border-color:#bfe5c8}.dn-error{background:#fff0f0;border-color:#efbbbb}.dn-warning{background:#fff9e8;border-color:#ecd98a}.dn-info{background:#f5f6fb;border-color:#d7dbea}
.dn-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:24px 0}.dn-card{display:flex;flex-direction:column;gap:6px;padding:20px;border:1px solid var(--dn-border);border-radius:var(--dn-radius);text-decoration:none!important;background:#fff;color:inherit!important}.dn-card strong{font-size:1.15rem}.dn-card span{color:var(--dn-muted)}@media(max-width:760px){.dn-cards{grid-template-columns:1fr}}
.dn-heading-row{display:flex;justify-content:space-between;align-items:flex-start;gap:18px}.dn-heading-row h1{margin-top:0}@media(max-width:650px){.dn-heading-row{display:block}.dn-heading-row .dn-button{margin-bottom:14px}}
.dn-profile-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.dn-profile-card{border:1px solid var(--dn-border);border-radius:20px;overflow:hidden;background:#fff;box-shadow:0 6px 28px rgba(60,30,45,.06)}.dn-photo{position:relative;aspect-ratio:4/3;background:#f2edef;overflow:hidden}.dn-photo img{width:100%;height:100%;object-fit:cover}.dn-photo-placeholder{display:flex;height:100%;align-items:center;justify-content:center;color:var(--dn-muted)}.dn-score,.dn-incoming{position:absolute;left:12px;padding:7px 10px;border-radius:999px;background:rgba(255,255,255,.94);font-weight:750;font-size:.86rem}.dn-score{top:12px}.dn-incoming{bottom:12px}.dn-profile-body{padding:18px}.dn-profile-body h2{margin:0 0 5px}.dn-meta{color:var(--dn-muted);margin:5px 0}.dn-reasons{padding:0;list-style:none;margin:14px 0}.dn-reasons li{margin:5px 0}.dn-tags{display:flex;flex-wrap:wrap;gap:7px;align-items:center;margin:14px 0}.dn-tags span{background:#f5eef1;border-radius:999px;padding:5px 9px;fon